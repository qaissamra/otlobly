# Copy to ".env" and fill in. Never commit the real .env.
# Load before running:  set -a; source .env; set +a; python3 clickup.py

# ClickUp -> Settings -> Apps -> personal API token (starts with pk_)
CLICKUP_API_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: SerpAPI keys for a pre-order price ESTIMATE only (item price, not landed).
# Rotated to spread the ~30-credit-per-run cost. Leave blank to disable estimates.
SERPAPI_KEY=
SERPAPI_KEY_2=
SERPAPI_KEY_3=

# Optional: needed if config.sheets.mode == "api" OR config.pnl.revenue.mode == "sheet".
# Absolute path to a Google service-account JSON with access to the sheet
# (share the sheet with the service-account email).
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: Meta Ads spend for the P&L page (config.pnl.meta.mode == "api").
#   META_AD_ACCOUNT_ID : Ads Manager account dropdown, looks like act_1234567890
#   META_ACCESS_TOKEN  : a token with ads_read (Business Settings -> System Users ->
#                        Generate token; or a short-lived Graph API Explorer token).
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=

# Optional: parcelsapp.com API key — tier-2 tracking fallback used only when
# GAASH itself is down. Leave blank to disable (an outage then shows the
# last-known cached status with an "as of" date).
PARCELSAPP_API_KEY=

# Optional: customer email login (portal second method next to WhatsApp).
#   RESEND_API_KEY : resend.com API key (email is sent over HTTPS, not SMTP)
#   EMAIL_FROM     : sender, e.g. Otlobly <login@otlobly.com> — leave blank to use
#                    Resend's onboarding sender until your domain is verified
#   OTLOBLY_EMAIL_DEV=1 shows the code on screen instead (local testing / pre-setup)
RESEND_API_KEY=
EMAIL_FROM=
